								}
							},
							"application/xml": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/Document"
									},
									"type": "array"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
